# Copy this file to .env and fill in your real values. .env is gitignored.

# Neon connection string — copy from the Neon dashboard (Connection Details).
# Must use the "postgresql://" scheme (not "postgres://") and keep ?sslmode=require.
HMS_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

HMS_SECRET_KEY=change-me-in-production
HMS_CORS_ORIGINS=*
